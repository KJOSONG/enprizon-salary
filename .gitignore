venv/
__pycache__/
*.pyc
.env
*.log
# data 目录整体忽略（数据库与备份，运行时数据；仅保留 source/.gitkeep 目录占位）
data/
!data/source/.gitkeep
# KILWA_SECRET_KEY dev pin file (redundant with data/ ignore, explicit for clarity)
data/.kilwa_secret
_work/
uploads/*
!uploads/.gitkeep
static/avatars/*
!static/avatars/.gitkeep
.DS_Store
*.bak.*
.memory

# Codebuddy/Workbuddy project dirs
.codebuddy/
.workbuddy/
.codebase-memory/
.trae/

# oh-my-openagent 运行时状态目录（非应用代码）
.omo/

# 设计工具工作目录（非应用代码，含 .DS_Store / 图标 / json）
.design/
